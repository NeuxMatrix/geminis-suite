<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Géminis Suite</title>
    <welcome file="bienvenida.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <domains enable_localSystem="true"/>
    <volume-check><allowed-os-versions><os-version min="10.13"/></allowed-os-versions></volume-check>
    <choices-outline><line choice="geminis"/></choices-outline>
    <choice id="geminis" title="Géminis Suite"><pkg-ref id="com.geminisaudio.suite"/></choice>
    <pkg-ref id="com.geminisaudio.suite">geminis.pkg</pkg-ref>
</installer-gui-script>
